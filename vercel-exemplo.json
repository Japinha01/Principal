{
  "redirects": [
    { "source": "/sina", "destination": "/sina/", "permanent": false },
    { "source": "/loja", "destination": "https://loja.japax01.com.br", "permanent": false },
    { "source": "/loja/:path*", "destination": "https://loja.japax01.com.br/:path*", "permanent": false }
  ],
  "rewrites": [
    { "source": "/sina/lancamento", "destination": "/sina/lancamento.html" },
    { "source": "/sina/privacidade", "destination": "/sina/privacidade.html" }
  ],
  "headers": [
    {
      "source": "/sina/manifest.json",
      "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }]
    },
    {
      "source": "/sina/sw.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript" },
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/sina/" }
      ]
    },
    {
      "source": "/sina/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
